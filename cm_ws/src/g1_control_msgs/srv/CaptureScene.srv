# Snapshot the latest RealSense frames, segment the colour image with SAM 3 and fit
# an oriented box to the depth points of each detection.
#
# The frames and masks are not returned here but published (latched) on
# /g1_perception/snapshot/{color,depth,depth_info,cloud,label_image}, all stamped
# with `stamp`. label_image is 16UC1 in colour pixels: 0 = no detection,
# i + 1 = detection i (higher score wins where masks overlap).

string[] prompts                     # text prompts, empty = the node's default prompts
---
bool success
string message
builtin_interfaces/Time stamp        # camera frame the detections belong to
string[] labels                      # prompt of each detection, sorted by score (descending)
float32[] scores
g1_control_msgs/Box[] boxes          # inflated boxes, depth optical frame; detections
                                     # without enough depth points get none
